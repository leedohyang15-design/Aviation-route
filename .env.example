# Copy this file to ".env" and fill in your OpenSky API client credentials.
# Get them at: https://opensky-network.org/  →  Account  →  API Client (create)
#
# With these set, the hub polls real worldwide traffic. Without them, it runs
# the built-in mock feed. The .env file is git-ignored.

OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""

# --- Weather tab (☁ 날씨): cloud and rain from ONE model ---------------------
#
# Cloud AND rain come from OpenWeatherMap on one key: the model's own total
# cloud cover and its precipitation, global, at the same instant.
#
# There is no fallback. Without a key the weather tab stays empty and the log
# says so - a state somebody can fix in a minute, rather than a plausible wrong
# picture nobody notices. The satellite-imagery fallback that used to sit here
# was removed: its cloud was a photograph and its rain only existed where a
# country has ground radar, and reconciling that pairing caused more faults than
# it ever covered for.
#
# Why one source matters: when the cloud is a geostationary satellite's infrared
# photograph and the rain is a model's forecast, they are different measurements. Measured on the same grid at the
# same instants they correlate at 0.39 - right place, right time, and still not
# the same weather, because infrared sees cold cloud TOPS rather than cloud, and
# the model parameterises convection inside its grid cells. That gap cannot be
# closed by code.
#
# Every public weather map this gets compared against solves it the same way:
# their "cloud" is not a photograph either, it is the model's own total cloud
# cover. One model, one timestamp, so the two agree by construction.
#
# Free, no card: https://home.openweathermap.org/users/sign_up -> API keys.
# A new key can take up to a couple of hours to start answering.
#
# Trade-off: model cloud is smooth and complete (it sees low cloud, and it
# covers the poles) but it loses the satellite photograph's detail - a typhoon
# becomes a smooth swirl rather than a photographed spiral. The log line
# "[weather] source: ..." always says which one is live.

OPENWEATHER_KEY=""

# Diagnostics for the weather tab. Writes the raw sensor pictures AND the
# assembled textures beside the exe as PNGs, so a seam or a gap can be looked
# at directly instead of guessed at from a screenshot.
# WEATHER_DEBUG_DUMP=1

# --- Optional tuning ---------------------------------------------------------

# Mip chain + anisotropic filtering on the world maps. ON by default.
#
# The day map is 16384px wide against a 1664px frame, so one screen pixel covers
# about ten texels; without a mip chain the sampler reads four of them and reads
# four DIFFERENT ones as soon as the view moves, which is the fizzing along
# coastlines that used to be mistaken for a seam. The wrap itself measures clean
# (see the "[earth] seam test" line in the log).
#
# Set to 0 to go back to unfiltered sampling. The log reports what the wrap
# column is doing either way, so the trade can be measured rather than argued.
# EARTH_MIPMAPS=0

# How many time steps to animate. Each one is a full tile grid, so this is the
# knob that trades bandwidth for motion. 1 = a still picture.
# WEATHER_FRAME_COUNT=4
# How long each step is held, in ms.
# WEATHER_FRAME_HOLD_MS=1600

# OpenSky poll interval (ms). Free tier = 4000 credits/day; a worldwide request
# costs ~4 credits (~1000/day). For all-day operation use 30000–60000; for short
# demo sessions 15000 is fine. Dead-reckoning keeps motion smooth regardless.
# OPENSKY_POLL_INTERVAL_MS=15000

# Force the mock feed even if credentials are present.
# FEED=mock

# Equirectangular render width (must stay 2:1; height is derived).
# EQUIRECT_WIDTH=4096
